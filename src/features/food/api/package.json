{
  "name": "aparajeyo-food-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test tests/repo && bun --bun vitest run",
    "test:unit": "bun --bun vitest run --project unit",
    "test:integration": "bun test tests/repo && bun --bun vitest run --project integration",
    "test:types": "bun --bun vitest run --project types",
    "test:directus": "bun --bun vitest run --project directus",
    "test:migrations": "bash ../scripts/test-migrations.sh",
    "contract:check": "bash ../scripts/sync-contract.sh --check && bun ../scripts/validate-mocks.ts",
    "gen:enums": "bun ../scripts/gen-enums.ts",
    "typecheck": "bun --bun tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "hono": "4.13.22",
    "ioredis": "^5.10.0",
    "postgres": "^3.4.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@types/bun": "^1.4.5",
    "dbmate": "^2.38.2",
    "testcontainers": "^12.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
