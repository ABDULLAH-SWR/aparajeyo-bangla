# Placeholders only. scripts/dev-up.sh writes real random values to .env.local.
POSTGRES_PASSWORD=change-me
# Owner role: dbmate migrations, db-bootstrap-roles.sh and the boundary load only.
DATABASE_URL_OWNER=postgresql://food:change-me@127.0.0.1:5433/aparajeyo_food?sslmode=disable
# Passwords given to the food_api and food_worker roles by db-bootstrap-roles.sh. Use hex: compose
# writes the API's one into a connection URL.
FOOD_API_DB_PASSWORD=change-me
FOOD_WORKER_DB_PASSWORD=change-me
# Directus connects as directus_food; db-bootstrap-roles.sh gives that role this password.
DIRECTUS_DB_PASSWORD=change-me
# Where directus-bootstrap.ts reaches Directus.
DIRECTUS_URL=http://127.0.0.1:8055
# The API connects as food_api.
DATABASE_URL=postgresql://food_api:change-me@127.0.0.1:5433/aparajeyo_food
# Workers connect as food_worker: put this DATABASE_URL in workers/.env.local, which they read first.
# DATABASE_URL=postgresql://food_worker:change-me@127.0.0.1:5433/aparajeyo_food
# openssl rand -hex 32
IMGPROXY_KEY=change-me
IMGPROXY_SALT=change-me
# Photo storage. S3_REGION and S3_BUCKET are defined here only: Garage, imgproxy, the API and the
# workers all read them.
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=ap-south-1
S3_BUCKET=food-media
# scripts/garage-bootstrap.sh creates both keys and prints them once. Until then any value will do.
# The workers' key (read and write):
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
# imgproxy's key (read only):
S3_IMGPROXY_ACCESS_KEY=change-me
S3_IMGPROXY_SECRET_KEY=change-me
# Sent to Wikimedia by food-photo-sync: a project name and URL, never a personal email.
WIKIMEDIA_USER_AGENT=AparajeyoFoodSync/0.1 (https://aparajeyo.com)
GARAGE_RPC_SECRET=change-me
GARAGE_ADMIN_TOKEN=change-me
DIRECTUS_SECRET=change-me
DIRECTUS_ADMIN_EMAIL=admin@example.invalid
DIRECTUS_ADMIN_PASSWORD=change-me
FOOD_INVALIDATE_TOKEN=change-me
# API settings. The API refuses to start without the ones that have no default (Guide Appendix E);
# dev-up.sh adds these dev values to .env.local.
NODE_ENV=development
VALKEY_URL=redis://127.0.0.1:6382/0
IMGPROXY_BASE_URL=http://127.0.0.1:8081
# Comma-separated. "*" is rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Never 0.0.0.0 or ::.
FOOD_INTERNAL_BIND_ADDR=127.0.0.1
GEO_CODES_PATH=data/geo_codes.v03.json
# The cache warmer (food-cache-warm) requests the pins from this running API.
FOOD_API_BASE_URL=http://127.0.0.1:8002
# Optional: PORT=8002, FOOD_INTERNAL_PORT=8003, PHOTO_MAX_BYTES=10485760
