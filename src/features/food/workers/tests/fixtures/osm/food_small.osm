<?xml version="1.0" encoding="UTF-8"?>
<!-- 12 nodes and 2 ways across Dhaka and Bogura. Nodes 1-4 and 6 are food POIs, node 5 is not food,
     nodes 7-12 are the corners of the two ways. -->
